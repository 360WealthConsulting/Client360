# Client360 production environment (Windows Server) — copy to C:\Client360\app\.env
# NEVER commit the real file. Keep a secure offline backup. No secrets are shown here.

# --- Core -------------------------------------------------------------------
CLIENT360_ENVIRONMENT=production
DATABASE_URL=postgresql://client360_app:CHANGE_ME@localhost:5432/client360
SESSION_SECRET=CHANGE_ME_STRONG_RANDOM_64_CHARS

# --- Entra / OIDC staff sign-in (required in production) --------------------
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<entra-app-client-id>
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REQUIRE_MFA=true

# --- Microsoft 365 sync (recommended; needed for mail/calendar + token cache) ---
MICROSOFT_TENANT_ID=<tenant-id>
MICROSOFT_CLIENT_ID=<entra-app-client-id>
MICROSOFT_CLIENT_SECRET=CHANGE_ME
MICROSOFT_REDIRECT_URI=https://client360.internal.example/auth/callback
MICROSOFT_TOKEN_KEY=CHANGE_ME_FERNET_KEY   # back up separately from the database

# --- SharePoint content connector (app.connectors.microsoft365.sharepoint_content) ---
MICROSOFT_SHAREPOINT_SITE_IDS=<comma-separated-graph-site-ids>   # or pass --sites
CLIENT360_SHAREPOINT_STAGING_ROOT=D:\Client360\Content\Staging\SharePoint   # local staging dir (fails closed if unset)

# --- Networking / hardening -------------------------------------------------
ALLOWED_HOSTS=client360.internal.example
TRUSTED_PROXY=127.0.0.1
PUBLIC_STAFF_URL=https://client360.internal.example
PUBLIC_PORTAL_URL=https://client360.internal.example/portal/login

# --- Storage + logs (persistent server locations) ---------------------------
VAULT_STORAGE_ROOT=C:\Client360\data\vault
LOG_DIR=C:\Client360\logs
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- TaxDome Drive document sync (see docs/TAXDOME_DOCUMENT_SYNC.md) ---------
# Read-only TaxDome Drive source (mapped per-user; the sync must run as an account that can see Z:).
TAXDOME_DRIVE_ROOT=Z:\
# Durable local copies live here (source-relative structure preserved).
CLIENT360_TAXDOME_DOCUMENT_ROOT=C:\Client360\Data\Documents\TaxDome
# Keep local copies when a source file disappears (recommended). true = allow automated purge.
TAXDOME_SYNC_DELETE_MISSING=false
# Print a progress line every N files examined during a long scan.
TAXDOME_SYNC_PROGRESS_INTERVAL=100

# --- Optional pre-migration backup hook (run by `python -m app.deploy migrate --backup`) ---
# CLIENT360_BACKUP_CMD=pg_dump -Fc client360 -f C:\Client360\backups\pre-migrate.dump
