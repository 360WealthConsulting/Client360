# Client360 — example environment configuration (E1.1 scaffold).
#
# SAFE TO COMMIT: this file contains NO secrets, credentials, tokens, or PII.
# DEVELOPMENT/LOCAL template. Copy the values you need into the repo-relative app/.env (which is
# gitignored) for local runs. This is NOT the production file: the Windows production runtime env
# file is C:\Client360\app\.env and is documented in deploy/windows/README.md.
# The authoritative variable list lives in app/config.py and the deployment runbook.
#
# Values below are placeholders or safe development defaults only.

# "production" enables strict mode (SESSION_SECRET required, HTTPS-only cookies).
CLIENT360_ENVIRONMENT=development

# PostgreSQL connection string. No built-in default — must be set for the app to
# start. Localhost dev value shown; the test suite uses a disposable *_test DB.
DATABASE_URL=postgresql://localhost/client360

# Session cookie signing key. REQUIRED in production (startup fails without it).
# Leave EMPTY in development to use the marked insecure development fallback.
SESSION_SECRET=

# Fernet key encrypting Microsoft OAuth token caches. REQUIRED only for
# Microsoft 365 sync; leave EMPTY to disable that sync. Back it up separately
# from the database. Do NOT commit a real key.
MICROSOFT_TOKEN_KEY=

# --- SharePoint content connector (app.connectors.microsoft365.sharepoint_content) -----------
# Per-deployment configuration for staging SharePoint content (no secrets). Both may be empty in
# development unless you are staging SharePoint.
#   MICROSOFT_SHAREPOINT_SITE_IDS     : comma-separated Graph site IDs to enumerate (or pass --sites).
#   CLIENT360_SHAREPOINT_STAGING_ROOT : local dir for downloaded files + manifest.json (or pass --staging).
#                                       The connector FAILS CLOSED if neither this nor --staging is set.
MICROSOFT_SHAREPOINT_SITE_IDS=
CLIENT360_SHAREPOINT_STAGING_ROOT=

# --- Observability (E1.5) ----------------------------------------------------
# Application logging for the `client360` logger namespace (does not affect
# uvicorn's own logs). Safe defaults applied in code if unset.
#   LOG_LEVEL  : DEBUG | INFO | WARNING | ERROR | CRITICAL   (default INFO)
#   LOG_FORMAT : plain | json                                (default plain)
LOG_LEVEL=INFO
LOG_FORMAT=plain

# --- Transactional outbox dispatcher (E1.6 / F1.3) ---------------------------
# The outbox mechanism always ships; the background DISPATCHER is opt-in and OFF
# by default (nothing publishes events yet, so enabling it changes nothing until
# producers/subscribers exist).
#   OUTBOX_DISPATCHER_ENABLED       : true|false                 (default false)
#   OUTBOX_DISPATCH_INTERVAL_SECONDS: poll cadence, min 5        (default 30)
OUTBOX_DISPATCHER_ENABLED=false
OUTBOX_DISPATCH_INTERVAL_SECONDS=30

# --- OCR execution (app.jobs.ocr_runner / app.services.document_ocr) ---------
# Per-document subprocess isolation gives OCR a REAL wall-clock timeout: each document is extracted in a
# killable child process (hard cap + stall watchdog), so a pathological PDF/image can never wedge the
# parent. It is ON BY DEFAULT (unset == enabled) for every OCR entrypoint. Set to 0 ONLY for local
# diagnostics — NEVER in production (without it, one wedged document hangs the whole run).
#   OCR_SUBPROCESS_ISOLATION=1                # default; 0 = diagnostics-only in-process mode
# Cooperative per-page / per-document OCR budgets (seconds); the isolation hard cap is derived above these.
#   OCR_PAGE_TIMEOUT_SECONDS=45
#   OCR_DOCUMENT_TIMEOUT_SECONDS=300

# --- Image normalization (app.services.image_normalization) ------------------
# iPhone HEIC/HEIF uploads are stored EXACTLY as uploaded; a normalized JPEG derivative is generated
# beside them for OCR, browser previews and AI image inputs. This is where those derivatives live —
# generated files only, never an original, and every one is rebuildable from its source document.
# Development default: data/derivatives (beside data/vault; /data/ is gitignored).
# PRODUCTION: this MUST be set to an ABSOLUTE path — the relative default resolves against the
# service working directory, which is how derivatives could land inside a deployed source tree.
# Normalization fails closed (recording a retryable 'failed' state, original untouched) if it is
# unset or relative in production. Verified by `python -m app.deploy check-config` and by
# `python -m app.services.image_normalization --preflight`.
IMAGE_DERIVATIVE_ROOT=

# --- Optional operational tunables (safe defaults applied in code if unset) ---
BENEFITS_NEW_HIRE_WINDOW_DAYS=30
BENEFITS_RENEWAL_WARNING_DAYS=60
BENEFITS_OE_WARNING_DAYS=7
BENEFITS_SCAN_INTERVAL_MINUTES=30
INSURANCE_SCAN_INTERVAL_MINUTES=30
